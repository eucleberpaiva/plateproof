# No media, model or result belongs in this repository: video has people and plates in it, and
# raw.json.gz / crops / audit.json / texts.json carry plate TEXT.
out/
output/
models/
*.mp4
*.mov
*.avi
*.mkv
*.onnx
*.json.gz
# no image either: a frame of your footage is still your footage, and a contact sheet from plateproof.audit
# has the plate text drawn onto the pixels, where the safety net cannot see it
*.png
*.jpg
*.jpeg
# your own scene calibration stays out of git until you decide otherwise
scenes/*.toml
!scenes/example-intersection.toml

.venv/
__pycache__/
*.pyc
.env
.env.*
desktop.ini
.DS_Store
